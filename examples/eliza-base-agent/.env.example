# ── plugin-tereno example: a Base agent that checks before it signs ──

# Start free: dry-run makes every check simulate with NO x402 payment and NO wallet.
TERENO_DRY_RUN=true

# Network. Hosted Tereno (www.tereno.xyz) serves Base MAINNET.
# For Base Sepolia, run your own Tereno with X402_NETWORK=eip155:84532 and set
# TERENO_API_URL to it, plus TERENO_NETWORK=eip155:84532.
TERENO_NETWORK=eip155:8453
# TERENO_API_URL=https://www.tereno.xyz

# ── Going live (set TERENO_DRY_RUN=false first) ──
# Dedicated hot wallet with a little USDC on Base. NEVER your main wallet.
# TERENO_PRIVATE_KEY=0xyour_dedicated_hot_wallet_key
TERENO_MAX_PRICE_USD=0.005      # per-call USDC cap
TERENO_DAILY_BUDGET_USD=0.05    # rolling daily USDC cap
TERENO_FAIL_MODE=closed         # financial checks abort if the guard can't answer
TERENO_PRIVATE_ONLY=true        # strangers in public channels can't spend your USDC

# Anonymous, opt-out usage telemetry (hashed wallet only, never keys/prompts).
# TERENO_TELEMETRY=off

# Your model provider key (any ElizaOS-supported provider), e.g.:
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
